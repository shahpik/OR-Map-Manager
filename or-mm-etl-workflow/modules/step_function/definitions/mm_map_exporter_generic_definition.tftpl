{
    "Comment": "MapExporter - Generic Step Function",
    "StartAt": "Choice - Check Input",
    "States": {
        "Choice - Check Input": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.julia_function",
                    "IsPresent": true,
                    "Next": "Lambda - Initiate Job - MapExporter - Generic Function"
                }
            ],
            "Default": "LoadDefaults"
        },
        "LoadDefaults": {
            "Type": "Pass",
            "Result": {
                "julia_function": ""
            },
            "ResultPath": "$.julia_function",
            "Next": "Lambda - Initiate Job - MapExporter - Generic Function"
        },
        "Lambda - Initiate Job - MapExporter - Generic Function": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
                "FunctionName": "${lambda_function_arn}",
                "Payload": {
                    "mode": "INITIATE",
                    "job_params": {
                        "namespace": "${namespace}",
                        "name": "${sfn_definition_prefix}-function",
                        "image": "${jsondecode(sfn_service_versions)["MapExporter"]["image"]}:${jsondecode(sfn_service_versions)["MapExporter"]["version"]}",
                        "julia_function": "$.julia_function",
                        "julia_module": "MapExporter",
                        "env_prefix": "${env_prefix}",
                        "k8s_microservice_name": "map-exporter",
                        "port": "6702",
                        "cpu_limits": "${cpu_4xlarge}",
                        "memory_limits": "${memory_20xlarge}",
                        "cpu_requests": "${cpu_2xlarge}",
                        "memory_requests": "${memory_5xlarge}",
                        "eks_backoff_limit": 0
                    }
                }
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 6,
                    "BackoffRate": 2
                }
            ],
            "Next": "Wait - MapExporter - Generic Function"
        },
        "Wait - MapExporter - Generic Function": {
            "Type": "Wait",
            "Seconds": 10,
            "Next": "Lambda - Monitor Job - MapExporter - Generic Function"
          },
          "Lambda - Monitor Job - MapExporter - Generic Function": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${lambda_function_arn}",
              "Payload": {
                "mode": "MONITOR",
                "job_params": {
                  "namespace": "${namespace}",
                  "name": "${sfn_definition_prefix}-function"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Next": "Choice - MapExporter - Generic Function"
          },
          "Choice - MapExporter - Generic Function": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.Payload.job_status",
                "StringMatches": "Success",
                "Next": "Lambda - Cleanup Job - MapExporter - Generic Function"
              },
              {
                "Variable": "$.Payload.job_status",
                "StringMatches": "Running",
                "Next": "Wait - MapExporter - Generic Function"
              }
            ],
            "Default": "Lambda - Cleanup Job - MapExporter - Generic Function"
          },
          "Lambda - Cleanup Job - MapExporter - Generic Function": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
              "FunctionName": "${lambda_function_arn}",
              "Payload": {
                "mode": "DELETE",
                "job_params": {
                  "namespace": "${namespace}",
                  "name": "${sfn_definition_prefix}-function"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
    }
}