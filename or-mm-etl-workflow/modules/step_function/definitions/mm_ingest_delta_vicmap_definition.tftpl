{
  "Comment": "VICMAP_TRANSPORT Source Ingestion Step Function",
  "StartAt": "Choice - Check Input",
  "States": {
    "Choice - Check Input": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resume_from",
          "IsPresent": true,
          "Next": "Choice - Resume From"
        }
      ],
      "Default": "LoadDefaults"
    },
    "LoadDefaults": {
      "Type": "Pass",
      "Result": {
        "resume_from": "Lambda - Initiate Job - MapEditor - Create Changeset"
      },
      "ResultPath": "$.resume_from",
      "Next": "Choice - Resume From"
    },
    "FailState": {
      "Type": "Fail",
      "Error": "Error"
    },
    "SuccessState": {
      "Type": "Pass",
      "End": true
    },
    "Choice - Resume From": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Create Changeset",
          "Next": "Lambda - Initiate Job - MapEditor - Create Changeset"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Truncate All Temp Tables Pre Ingestion",
          "Next": "Lambda - Initiate Job - MapImporter - Truncate All Temp Tables Pre Ingestion"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Ingest Data",
          "Next": "Lambda - Initiate Job - MapImporter - Ingest Data"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Calculate Delta",
          "Next": "Lambda - Initiate Job - MapImporter - Calculate Delta"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Update Changeset Status",
          "Next": "Lambda - Initiate Job - MapEditor - Update Changeset Status"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Check Changeset Status",
          "Next": "Lambda - Initiate Job - MapEditor - Check Changeset Status"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Source Update Publish Changeset",
          "Next": "Lambda - Initiate Job - MapEditor - Source Update Publish Changeset"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Update Changeset Status Post Approval",
          "Next": "Lambda - Initiate Job - MapEditor - Update Changeset Status Post Approval"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table Post Published",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table Post Published"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Run Matching",
          "Next": "Lambda - Initiate Job - MapMatcher - Run Matching"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Invalidate Previous OSM Relationships",
          "Next": "Lambda - Initiate Job - MapMatcher - Invalidate Previous OSM Relationships"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Truncate All Temp Tables Post Ingestion",
          "Next": "Lambda - Initiate Job - MapImporter - Truncate All Temp Tables Post Ingestion"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Create Derived Layer",
          "Next": "Lambda - Initiate Job - MapMatcher - Create Derived Layer"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Copy Unbroken OSM Data",
          "Next": "Lambda - Initiate Job - MapMatcher - Copy Unbroken OSM Data"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Delta Persistence",
          "Next": "Lambda - Initiate Job - MapMatcher - Delta Persistence"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh DTP Feature MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh DTP Feature MV"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Run Matching Against Derived Layer",
          "Next": "Lambda - Initiate Job - MapMatcher - Run Matching Against Derived Layer"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Invalidate Previous DTP Relationships",
          "Next": "Lambda - Initiate Job - MapMatcher - Invalidate Previous DTP Relationships"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh DTP Relationship MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh DTP Relationship MV"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Generate Match Reports",
          "Next": "Lambda - Initiate Job - MapMatcher - Generate Match Reports"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapExporter - Export to S3",
          "Next": "Lambda - Initiate Job - MapExporter - Export to S3"
        },  
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapIntersectionExporter - Run Calculate Intersections",
          "Next": "Lambda - Initiate Job - MapIntersectionExporter - Run Calculate Intersections"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh Intersections MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh Intersections MV"
        }
      ],
      "Default": "Lambda - Initiate Job - MapEditor - Create Changeset"
    },
    "Lambda - Initiate Job - MapEditor - Create Changeset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-editor-create-changeset",
            "image": "${jsondecode(sfn_service_versions)["MapEditor"]["image"]}:${jsondecode(sfn_service_versions)["MapEditor"]["version"]}",
            "julia_function": "MapEditor.App.step_create_changeset(:VICMAP_TRANSPORT)",
            "julia_module": "MapEditor",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-editor",
            "port": "6703",
            "cpu_limits": "${cpu_medium}",
            "memory_limits": "${memory_medium}",
            "cpu_requests": "${cpu_small}",
            "memory_requests": "${memory_small}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapEditor - Create Changeset"
    },
    "Wait - MapEditor - Create Changeset": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "Lambda - Monitor Job - MapEditor - Create Changeset"
    },
    "Lambda - Monitor Job - MapEditor - Create Changeset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-editor-create-changeset"
          }
        }
      },
