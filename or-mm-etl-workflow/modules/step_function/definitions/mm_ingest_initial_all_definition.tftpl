{
  "Comment": "Initial OSM Load Step Function",
  "StartAt": "Choice - Check Input",
  "States": {
    "Choice - Check Input": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resume_from",
          "IsPresent": true,
          "Next": "Choice - Resume From"
        },
        {
          "Variable": "$.force_truncate",
          "IsPresent": true,
          "Next": "Choice - MapImporter - Force Truncate Tables"
        }
      ],
      "Default": "LoadDefaults"
    },
    "LoadDefaults": {
      "Type": "Pass",
      "Result": {
        "resume_from": "Choice - MapImporter - Force Truncate Tables",
        "force_truncate": false
      },
      "ResultPath": "$",
      "Next": "Choice - Resume From"
    },
    "FailState": {
      "Type": "Fail",
      "Error": "Error"
    },
    "SuccessState": {
      "Type": "Pass",
      "End": true
    },
    "Choice - Resume From": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resume_from",
          "StringEquals": "Choice - MapImporter - Force Truncate Tables",
          "Next": "Choice - MapImporter - Force Truncate Tables"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Truncate Tables",
          "Next": "Lambda - Initiate Job - MapImporter - Truncate Tables"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Check DB",
          "Next": "Lambda - Initiate Job - MapImporter - Check DB"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Create Initial Changeset",
          "Next": "Lambda - Initiate Job - MapImporter - Create Initial Changeset"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Ingest Data",
          "Next": "Lambda - Initiate Job - MapImporter - Ingest Data"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Run Matching",
          "Next": "Lambda - Initiate Job - MapMatcher - Run Matching"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Create Derived Layer",
          "Next": "Lambda - Initiate Job - MapMatcher - Create Derived Layer"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Copy Unbroken OSM Data",
          "Next": "Lambda - Initiate Job - MapMatcher - Copy Unbroken OSM Data"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh DTP Feature MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh DTP Feature MV"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapMatcher - Run Matching Against Derived Layer",
          "Next": "Lambda - Initiate Job - MapMatcher - Run Matching Against Derived Layer"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapImporter - Seed Custom Attribute Value",
          "Next": "Lambda - Initiate Job - MapImporter - Seed Custom Attribute Value"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh DTP Relationship MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh DTP Relationship MV"
        },        
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapExporter - Export to S3",
          "Next": "Lambda - Initiate Job - MapExporter - Export to S3"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapIntersectionExporter - Run Calculate Intersections",
          "Next": "Lambda - Initiate Job - MapIntersectionExporter - Run Calculate Intersections"
        },
        {
          "Variable": "$.resume_from",
          "StringEquals": "Lambda - Initiate Job - MapEditor - Refresh Intersections MV",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh Intersections MV"
        }
      ],
      "Default": "Choice - MapImporter - Force Truncate Tables"
    },
    "Choice - MapImporter - Force Truncate Tables": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.force_truncate",
          "BooleanEquals": true,
          "Next": "Lambda - Initiate Job - MapImporter - Truncate Tables"
        },
        {
          "Variable": "$.force_truncate",
          "BooleanEquals": false,
          "Next": "Lambda - Initiate Job - MapImporter - Check DB"
        }
      ],
      "Default": "Lambda - Initiate Job - MapImporter - Check DB"
    },
    "Lambda - Initiate Job - MapImporter - Truncate Tables": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-truncate-tables",
            "image": "${jsondecode(sfn_service_versions)["MapImporter"]["image"]}:${jsondecode(sfn_service_versions)["MapImporter"]["version"]}",
            "julia_function": "MapImporter.App.step_truncate_tables_before_initial_load()",
            "julia_module": "MapImporter",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-importer",
            "port": "6701",
            "cpu_limits": "${cpu_medium}",
            "memory_limits": "${memory_medium}",
            "cpu_requests": "${cpu_small}",
            "memory_requests": "${memory_small}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapImporter - Truncate Tables"
    },
    "Wait - MapImporter - Truncate Tables": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Lambda - Monitor Job - MapImporter - Truncate Tables"
    },
    "Lambda - Monitor Job - MapImporter - Truncate Tables": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-truncate-tables"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Choice - MapImporter - Truncate Tables"
    },
    "Choice - MapImporter - Truncate Tables": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Success",
          "Next": "Lambda - Initiate Job - MapImporter - Check DB"
        },
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Running",
          "Next": "Wait - MapImporter - Truncate Tables"
        }
      ],
      "Default": "Lambda - Cleanup Job - MapImporter - Truncate Tables"
    },
    "Lambda - Cleanup Job - MapImporter - Truncate Tables": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "DELETE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-truncate-tables"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "FailState"
    },
    "Lambda - Initiate Job - MapImporter - Check DB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-check-db",
            "image": "${jsondecode(sfn_service_versions)["MapImporter"]["image"]}:${jsondecode(sfn_service_versions)["MapImporter"]["version"]}",
            "julia_function": "MapImporter.App.step_check_db_before_load()",
            "julia_module": "MapImporter",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-importer",
            "port": "6701",
            "cpu_limits": "${cpu_medium}",
            "memory_limits": "${memory_medium}",
            "cpu_requests": "${cpu_small}",
            "memory_requests": "${memory_small}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapImporter - Check DB"
    },
    "Wait - MapImporter - Check DB": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Lambda - Monitor Job - MapImporter - Check DB"
    },
    "Lambda - Monitor Job - MapImporter - Check DB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-check-db"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Choice - MapImporter - Check DB"
    },
    "Choice - MapImporter - Check DB": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Success",
          "Next": "Lambda - Initiate Job - MapImporter - Create Initial Changeset"
        },
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Running",
          "Next": "Wait - MapImporter - Check DB"
        }
      ],
      "Default": "Lambda - Cleanup Job - MapImporter - Check DB"
    },
    "Lambda - Cleanup Job - MapImporter - Check DB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "DELETE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-check-db"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "FailState"
    },
    "Lambda - Initiate Job - MapImporter - Create Initial Changeset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-init-changeset",
            "image": "${jsondecode(sfn_service_versions)["MapImporter"]["image"]}:${jsondecode(sfn_service_versions)["MapImporter"]["version"]}",
            "julia_function": "MapImporter.App.step_create_initial_changeset()",
            "julia_module": "MapImporter",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-importer",
            "port": "6701",
            "cpu_limits": "${cpu_medium}",
            "memory_limits": "${memory_medium}",
            "cpu_requests": "${cpu_small}",
            "memory_requests": "${memory_small}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapImporter - Create Initial Changeset"
    },
    "Wait - MapImporter - Create Initial Changeset": {
      "Type": "Wait",
      "Seconds": 2,
      "Next": "Lambda - Monitor Job - MapImporter - Create Initial Changeset"
    },
    "Lambda - Monitor Job - MapImporter - Create Initial Changeset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-init-changeset"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Choice - MapImporter - Create Initial Changeset"
    },
    "Choice - MapImporter - Create Initial Changeset": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Success",
          "Next": "Lambda - Initiate Job - MapImporter - Ingest Data"
        },
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Running",
          "Next": "Wait - MapImporter - Create Initial Changeset"
        }
      ],
      "Default": "Lambda - Cleanup Job - MapImporter - Create Initial Changeset"
    },
    "Lambda - Cleanup Job - MapImporter - Create Initial Changeset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "DELETE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-init-changeset"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "FailState"
    },
    "Lambda - Initiate Job - MapImporter - Ingest Data": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-ingest-data",
            "image": "${jsondecode(sfn_service_versions)["MapImporter"]["image"]}:${jsondecode(sfn_service_versions)["MapImporter"]["version"]}",
            "julia_function": "MapImporter.step_load_new_data_from_source_list([:HEX, :OSM, :CUSTOM_ATTRIBUTE, :DECLARED_NETWORK, :VICMAP_TRANSPORT, :CUSTOM_SEED_FILE]; debug=${debug}, job_mode=true)",
            "julia_module": "MapImporter",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-importer",
            "port": "6701",
            "cpu_limits": "${cpu_8xlarge}",
            "memory_limits": "${memory_50xlarge}",
            "cpu_requests": "${cpu_6xlarge}",
            "memory_requests": "${memory_10xlarge}",
            "eks_backoff_limit": 0
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapImporter - Ingest Data"
    },
    "Wait - MapImporter - Ingest Data": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "Lambda - Monitor Job - MapImporter - Ingest Data"
    },
    "Lambda - Monitor Job - MapImporter - Ingest Data": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-importer-ingest-data"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Choice - MapImporter - Ingest Data"
    },
    "Choice - MapImporter - Ingest Data": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Success",
          "Next": "Lambda - Initiate Job - MapEditor - Refresh MV Feat Table"
        },
        {
          "Variable": "$.Payload.job_status",
          "StringMatches": "Running",
          "Next": "Wait - MapImporter - Ingest Data"
        }
      ],
      "Default": "Lambda - Cleanup Job - MapImporter - Ingest Data"
    },
    "Lambda - Cleanup Job - MapImporter - Ingest Data": {
