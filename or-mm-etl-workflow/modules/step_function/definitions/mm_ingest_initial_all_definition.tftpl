    "Lambda - Initiate Job - MapMatcher - Run Matching": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${lambda_function_arn}",
        "Payload": {
          "mode": "INITIATE",
          "job_params": {
            "namespace": "${namespace}",
            "name": "${sfn_definition_prefix}-matcher-run-matching",
            "image": "${jsondecode(sfn_service_versions)["MapMatcher"]["image"]}:${jsondecode(sfn_service_versions)["MapMatcher"]["version"]}",
            "julia_function": "MapMatcher.step_run_map_matching_from_source_list([:VICMAP_TRANSPORT], :INITIAL_LOAD; original_osm=true, debug=${debug}, job_mode=true)",
            "julia_module": "MapMatcher",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-matcher",
            "port": "6702",
            "cpu_limits": "${cpu_20xlarge}",
            "memory_limits": "${memory_50xlarge}",
            "cpu_requests": "${cpu_8xlarge}",
            "memory_requests": "${memory_30xlarge}",
            "eks_job_ttl": 660
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
