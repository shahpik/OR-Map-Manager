            "julia_function": "MapEditor.App.step_refresh_mv_feature([:OSM, :VICMAP_TRANSPORT])",
            "julia_module": "MapEditor",
            "env_prefix": "${env_prefix}",
            "k8s_microservice_name": "map-editor",
            "port": "6703",
            "cpu_limits": "${cpu_medium}",
            "memory_limits": "${memory_xlarge}",
            "cpu_requests": "${cpu_small}",
            "memory_requests": "${memory_large}"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Next": "Wait - MapEditor - Refresh MV Feat Table"
    },
    "Wait - MapEditor - Refresh MV Feat Table": {
