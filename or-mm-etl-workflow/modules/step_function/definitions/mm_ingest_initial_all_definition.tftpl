    },
    "Lambda - Monitor Job - MapEditor - Refresh MV Feat Table": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload": {
          "mode": "MONITOR",
          "job_params": {
